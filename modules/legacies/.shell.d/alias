# This file must be loadable by Bash and Zsh.

#
# bat
#
alias cat=bat
alias less=bat
#
# diff
#
type colordiff &> /dev/null && alias diff=colordiff

#
# dpkg
#
alias dpkg='COLUMNS=${COLUMNS:-80} dpkg'

#
# Emacs
#
# HACK: Use the Cocoa Emacs if possible.
{
  # shellcheck disable=SC2139
  alias emacs="XMODIFIERS='@im=none' $(command -v Emacs || command -v emacs)"

  if type emacsclient; then
    export EDITOR="emacsclient -n"
    export GIT_EDITOR=emacsclient

    e() {
      local arg restructured_args

      for arg in "$@"; do
        if [[ $arg == *":"* ]]; then
          restructured_args="${restructured_args} +${arg##*:} ${arg%:*}"
          continue
        fi

        restructured_args="${restructured_args} ${arg}"
      done

      # shellcheck disable=SC2046
      # shellcheck disable=SC2116
      emacsclient -n $(echo "${restructured_args}")
    }
  else
    export EDITOR=vi
  fi
} &> /dev/null

#
# Git
#
alias g=git
alias gb='g browse'
alias gbr='g br'
alias gbrs='g brs'
alias gbrsr='g brsr'
alias gco='g co'
alias gf='g fetch'
alias gdi='g di'
alias gg='g grep'
alias gl='g log --stat --show-signature'
alias glp='gl -p'
alias gop='g open'
alias gpl='g pull'
alias gp='g p'
alias gps='g push'
alias gr='cd-gitroot'
alias grb='g rb'
alias gref='g ref'
alias gst='g st'

#
# grep
#
alias grep='grep --color=always'

#
# ls
#
case ${OSTYPE} in
  freebsd*|darwin*)
    alias ls='ls -wGF'
    ;;
  linux*)
    alias ls='ls -F --color=auto'
    ;;
esac

alias la='ls -AFH'
alias ll='la -l'

#
# Vim
#
type vim &> /dev/null && alias vi=vim

#
# Shorthand
#
alias b='bundle'
alias be='bundle exec'
alias d='docker'
alias dc='docker compose'
alias l=less
alias v=vagrant

