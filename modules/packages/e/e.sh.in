set -euo pipefail

# Transform filename:line arguments into emacsclient compatible format
# and preserve other arguments as-is
transform_args() {
  local args=()
  local arg

  while (( $# > 0 )); do
    arg="$1"
    if [[ "$arg" =~ ^([^:]+):([0-9]+)$ ]]; then
      # Extract filename and line number using regex match
      local file="${BASH_REMATCH[1]}"
      local line="${BASH_REMATCH[2]}"
      args+=("+$line" "$file")
    else
      args+=("$arg")
    fi
    shift
  done

  # Print the transformed arguments
  printf "%s\n" "${args[@]}"
}

# Transform and execute
if (( $# > 0 )); then
  # shellcheck disable=SC2046
  @emacsclient@ -n $(transform_args "$@")
else
  @emacsclient@ -n
fi

# Local Variables:
# mode: sh
# sh-shell: bash
# End:
