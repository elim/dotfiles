[alias]
	# command
	fixup  = !sh -c 'git commit -m \"fixup!  $(git log -1 --format='\\''%s'\\'' $@)\"' -
	squash = !sh -c 'git commit -m \"squash! $(git log -1 --format='\\''%s'\\'' $@)\"' -

	# internal use only
	updated-at = log --date=iso8601 -n 1 --pretty='format:[%ai] %h'
	list-local-branches  = !sh -c 'git branch                   | colrm 1 2'
	list-remote-branches = !sh -c 'git branch -r | grep -v HEAD | colrm 1 2'

	# shortcut
	br = branch
	brs  = "!f() {(for i in $(git list-local-branches);  do echo $(git updated-at $i) $i; done) | sort -r;}; f"
	brsr = "!f() {(for i in $(git list-remote-branches); do echo $(git updated-at $i) $i; done) | sort -r;}; f"
	ci = commit
	co = checkout
	di = diff
	f = fetch
	g = grep
	op = open
	p = !sh -c 'gh pr view --web 2> /dev/null || gh pr create --web 2> /dev/null || gh repo view --web'
	rb = rebase
	ref = reflog
	ri = rebase --interactive --autosquash
	st = status
	tr = log --graph --pretty='format:%C(yellow)%h%Creset %s %Cgreen(%an)%Creset %Cred%d%Creset'

[color]
	diff = auto
	status = auto
	branch = auto
	interactive = auto

[commit]
	cleanup = strip
	gpgsign = true

[core]
	autocrlf = input
	quotepath = false
	pager = delta

[interactive]
	diffFilter = delta --color-only

[diff]
	compactionHeuristic = true

[filter "lfs"]
	clean = git-lfs clean -- %f
	required = true
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process

[ghq]
	root = ~/src
	user = elim

[github]
	user = elim

[grep]
	lineNumber = true

[help]
	autocorrect = 1

[log]
	follow = true

[tig "bind"]
	generic = g move-first-line
	generic = G move-last-line

[user]
	email = takeru.naito@gmail.com
	name = Takeru Naito
	signingkey = 0A2D3E0E

[delta]
	navigate = true # use n and N to move between diff sections
	light = false	# set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)
	syntax-theme = Monokai Extended

[interactive]
	diffFilter = delta --color-only

[diff]
	colorMoved = default

# ------------------------------

[merge]
	conflictstyle = diff3

[pull]
	ff = only
[init]
	defaultBranch = main
