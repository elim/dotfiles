() {
  local inherit='local-once'
  [[ ${OSTYPE} =~ '^darwin*' ]] && inherit='any'

  if (( $+commands[keychain] )); then
    eval $(keychain \
             --eval \
             --ssh-allow-forwarded \
             --quiet \
             id_ed25519 0A2D3E0E)
  fi
}

